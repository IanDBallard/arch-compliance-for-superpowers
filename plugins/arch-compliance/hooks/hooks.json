{
  "description": "ACF SubagentStart constraint injection and PostToolUse Tier-1 gate. Active only when the host has `.acf/enabled` (written by /acf-setup).",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_constraints.py\" --format hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/posttooluse_gate.py\" --format hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
